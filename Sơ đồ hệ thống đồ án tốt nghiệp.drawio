        <object label="Hệ thống kiểm soát chất lượng không khí trong chung cư sử dụng cây trồng trong nhà" CC="- Giai đoạn trước khi cấy :  500 μmol mol−1" id="H2J6bb_nPBDOlBJRfUOo-41">
          <mxCell parent="1" style="swimlane;" vertex="1">
            <mxGeometry height="970" width="1370" x="1970" y="280" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="H2J6bb_nPBDOlBJRfUOo-42" parent="H2J6bb_nPBDOlBJRfUOo-41" style="shape=ext;double=1;whiteSpace=wrap;html=1;aspect=fixed;" value="" vertex="1">
          <mxGeometry height="420" width="420" x="770" y="305" as="geometry" />
        </mxCell>
        <object label="Đèn" RGB="-Cường độ ánh sáng cố định  200 μmol m^-2 s^-1&#xa;- Khoảng cách đặt đèn : 25-30 cm&#xa;- Chu kỳ chiếu sáng 16 giờ sáng / 8 giờ tố&#xa;-Giai đoạn trước khi cấy ( 2 tuần ): R:G:B = 30.6 : 44.0 : 25.4.&#xa;+ xanh lá chiếm tỷ lệ cao nhất (44.0%), điều này làm giảm hiện tượng cây con bị kéo dài thân quá mức. Nhờ đó, cây con phát triển dạng tán mở, lá trải đều, thân ngắn và cứng, giúp tăng khả năng đứng vững và thích nghi tốt sau khi cấy sang hệ thống thủy canh.&#xa;+Hàm lượng diệp lục cao (nhờ ánh sáng B kích thích sinh tổng hợp chlorophyll và mở khí khổng).&#xa;&#xa;- Giai đoạn đầu ES (0-2 tuần sau cấy) : R:G:B = 44.2 : 55.8 : 0&#xa;+ Việc loại bỏ hoàn toàn ánh sáng xanh lam (B) và tăng tỷ lệ ánh sáng xanh lá (G) kích thích phản ứng &quot;tránh bóng&quot; giúp cây mở rộng diện tích thu ánh sáng giúp cây hấp thụ được nhiều ánh sáng hơn&#xa;+ Tạo hiệu ứng chuyển tiếp : Mặc dù việc thiếu ánh sáng xanh lam có thể làm giảm hiệu suất quang hợp tạm thời (chỉ số diệp lục thấp), nhưng cấu trúc tán lá rộng được hình thành ở giai đoạn này sẽ giúp cây hấp thụ được nhiều ánh sáng hơn ở giai đoạn sau &#xa;&#xa;- Giai đoạn sau LS (2-4 tuần sau cấy) : R:G:B = 25.2 : 57.8 : 16.9&#xa;+ Thúc đẩy tích lũy vật chất khô&#xa;+ 16.9 xanh lam -&gt; dải phổ được diệp lục hấp thụ mạnh nhất -&gt; tăng cường hiệu suất quang hợp &#xa;+ cải thiện chất lượng lá : Ánh sáng xanh lam ở giai đoạn này giúp kích thích sinh tổng hợp diệp lục, làm cho lá có màu xanh đậm hơn,giúp rau có vẻ ngoài bắt mắt và giá trị thương mại cao hơn.&#xa;+Tỷ lệ ánh sáng xanh lá (G) vẫn được duy trì ở mức cao (57.8%) để tận dụng khả năng xuyên thấu sâu vào các lớp lá bên dưới và tầng tán thấp khi cây đã phát triển dày đặc, giúp toàn bộ cây đều tham gia vào quá trình quang hợp" id="H2J6bb_nPBDOlBJRfUOo-43">
          <mxCell parent="H2J6bb_nPBDOlBJRfUOo-41" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="50" width="120" x="530" y="180" as="geometry" />
          </mxCell>
        </object>
